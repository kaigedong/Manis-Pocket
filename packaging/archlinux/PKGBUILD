# Maintainer: bobo <https://aur.archlinux.org/account/bobosingle>

# The package is named after the product; the single binary it ships is the GPUI
# desktop app.
pkgname=manis-pocket
pkgver="$(bash "$startdir/../package-version.sh")"
pkgrel=1
pkgdesc='Manis Pocket clipboard manager and P2P sync client (GPUI)'
arch=('x86_64')
url='https://github.com/kaigedong/Manis-Pocket'
license=('MIT')
# wl-copy and wl-paste are executed at runtime, so namcap cannot detect this dependency.
depends=('glibc' 'libgcc' 'wl-clipboard' 'wayland' 'libxkbcommon' 'fontconfig' 'vulkan-icd-loader')
makedepends=('cargo' 'git' 'rust')
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked -p manis-pocket-app
}

check() {
  cd "$startdir/../.."
  CARGO_TARGET_DIR="$srcdir/target" cargo test --release --locked -p manis-pocket-sync --lib register::tests
}

package() {
  install -Dm755 "$srcdir/target/release/manis-pocket" \
    "$pkgdir/usr/bin/manis-pocket"
  install -Dm644 "$startdir/io.github.kaigedong.ManisPocket.desktop" \
    "$pkgdir/usr/share/applications/io.github.kaigedong.ManisPocket.desktop"
  install -Dm644 "$startdir/../../crates/manis-pocket-app/assets/app-icon.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.kaigedong.ManisPocket.png"
  install -Dm644 "$startdir/../../LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
